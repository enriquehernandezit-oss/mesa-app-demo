# Vite exposes only VITE_-prefixed vars to the client.
VITE_API_URL=http://localhost:3000

# MapBox — the restaurant-profile static map AND the interactive "Cerca" map.
# A public pk. token (client-side by design; restrict it to your domains in the
# MapBox account). Unset → the profile map falls back to a text tile and the
# near-me screen keeps Mesa's hand-drawn SVG map. This one IS VITE_-prefixed on
# purpose (unlike the server-only Google key): MapBox public tokens are meant to
# ship to the client.
VITE_MAPBOX_TOKEN=

# Cloudinary (unsigned upload preset for client-side image upload — added in M5)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
