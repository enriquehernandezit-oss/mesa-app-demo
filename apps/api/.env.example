# --- API server ---
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to call the API with credentials.
APP_ORIGINS=http://localhost:5173

# --- Database (Postgres on Railway; local Postgres for dev) ---
# The pool is configured once in packages/db from this URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mesa

# --- Better Auth ---
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Sign in with Apple (App Store 4.8 — required because Instagram login exists).
# Leave unset in dev; presence of APPLE_CLIENT_ID turns the provider on.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=

# Google sign-in (M10). The app signs in natively (an on-device ID token, no
# browser redirect), so two separate OAuth clients are involved: create both
# in Google Cloud Console -> APIs & Services -> Credentials.
#   - "Web application" client -> GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
#     Presence of BOTH turns the provider on; the secret never leaves this
#     server (never in EAS, never EXPO_PUBLIC_*).
#   - "iOS" client (bundle id = APPLE_APP_BUNDLE_ID's value; iOS clients have
#     no secret) -> GOOGLE_CLIENT_ID_IOS here, and set the SAME value as
#     apps/mobile/.env's EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (that one IS public —
#     client ids, unlike secrets, are meant to ship in the app bundle). A
#     token from either client is accepted (see auth.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=

# Instagram via Meta's official OAuth (App Store 4.5 — no scraping).
# Both CLIENT_ID and CLIENT_SECRET must be set to enable the provider.
# The URL/scope overrides let you match whichever Instagram Login flow Meta
# assigns your app (Basic Display is being retired).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTH_URL=https://api.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_USERINFO_URL=https://graph.instagram.com/me?fields=id,username
INSTAGRAM_SCOPES=user_profile

# Phone auth — dev logs the OTP to the console; set a real provider for prod.
# Unset -> the /phone-number/* routes are DISABLED and the app hides its phone
# button, so nothing offers a sign-in that cannot finish. Setting a key turns
# both back on. Also set VITE_PHONE_AUTH=1 on the web app.
SMS_PROVIDER_API_KEY=

# Contacts find-friends (M18). HMAC key for PUT /me/phone (a member's own
# opt-in number) and POST /social/contacts/match (numbers from a member's
# device address book, hashed in-request and never stored — see
# packages/db/src/phone.ts's own header). Unset -> both routes are dark,
# same convention as GOOGLE_PLACES_API_KEY. Set once on Railway to any long
# random string — rotating it invalidates every existing opt-in hash, so
# treat it as a one-time value, not a rotated secret.
PHONE_MATCH_SECRET=

# Transactional email (password reset + verification) via Resend.
# REQUIRED IN PRODUCTION — the API refuses to start without both of these.
# Password reset is the only way back into an account, so a missing mail setup
# is a failed deploy rather than an API that looks healthy and silently strands
# anyone who forgets their password. In dev, leave them unset: reset and
# verification links print to the console instead.
#
# Get the key at resend.com (starts "re_").
EMAIL_PROVIDER_API_KEY=
# The sender address. It MUST be on a domain you have verified in Resend
# (Domains -> Add -> add the SPF/DKIM/DMARC records it gives you). There is
# deliberately no default: the old fallback of onboarding@resend.dev is accepted
# by Resend but delivered ONLY to the Resend account owner, so every other
# member's reset vanished with nothing looking broken.
# EMAIL_FROM="Mesa <hola@yourdomain.com>"
EMAIL_FROM=

# Google Places (M8 typeahead + M9 create-from-Google). SERVER ONLY: never
# expose it to the client, never VITE_-prefix it (Vite inlines every VITE_*
# into the public bundle). Unset → both features are dark (no suggestions, and
# tapping a Google result 502s cleanly instead of creating a place). To enable:
# Google Cloud console → enable "Places API (New)" → create an API key →
# restrict it to Places API + your server → set it here.
# Two SKUs are billed: Autocomplete (typeahead, cheap) and Place Details
# (only when a member taps a suggestion — Enterprise tier, since the code
# requests address/phone/website/hours alongside id + name). A tap's Details
# call is cached into the row and re-fetched only every 30 days
# (google_refreshed_at / sourceRefreshedAt), and deduped by google_place_id so
# repeat taps on the same place never call Google again.
GOOGLE_PLACES_API_KEY=

# This API's own public origin (e.g. https://mesaapi-production-xxxx.up.railway.app).
# Two things need it. Share-page cover images resolve local /restaurants/*.jpg
# paths against it (this server serves those files) — unset → share pages render
# without a cover. And the password-reset / verify-email links this server emails
# point at its own /p/* pages — there it falls back to BETTER_AUTH_URL, then to
# APP_ORIGINS, so a correct Better Auth setup already works unset.
PUBLIC_API_URL=

# Where a share link's "open in Mesa" CTA sends a web visitor — the marketing or
# App Store landing page, now that the web app is retired. Falls back to the first
# APP_ORIGINS entry.
PUBLIC_WEB_URL=

# Cloudflare R2 (M23) — where a member's dish/avatar/collection-cover photo
# actually lands. All five required together, or POST /uploads answers
# { available: false } and the client skips attaching a photo rather than
# failing the whole post (see lib/r2.ts). Create a bucket + an R2 API token
# (Cloudflare dashboard → R2 → Manage API tokens) and enable public access on
# the bucket to get its pub-*.r2.dev URL (or attach a custom domain later).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public base URL, no trailing slash — e.g. https://pub-xxxx.r2.dev.
# Also read by share-pages.ts (og:image) and the CSP's imgSrc.
R2_PUBLIC_BASE_URL=

# Push notifications (M17), via Expo's push service. Unset -> every push is a
# silent no-op (same convention as GOOGLE_PLACES_API_KEY): dev boots and
# serves fine, it just never calls out. Create at expo.dev (account settings
# -> Access tokens) and set it here / on Railway.
EXPO_ACCESS_TOKEN=

# --- Crash reporting (optional) ---
# PostHog project API key, same project the mobile app reports to. Unset = no
# reports; the server boots and serves normally either way (unlike EMAIL_*,
# which refuses to start in production).
POSTHOG_API_KEY=
