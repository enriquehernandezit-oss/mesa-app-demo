# --- API server ---
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to call the API with credentials.
APP_ORIGINS=http://localhost:5173

# --- Database (Postgres on Railway; local Postgres for dev) ---
# The pool is configured once in packages/db from this URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mesa

# --- Better Auth ---
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Sign in with Apple (App Store 4.8 — required because Instagram login exists).
# Leave unset in dev; presence of APPLE_CLIENT_ID turns the provider on.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=

# Instagram via Meta's official OAuth (App Store 4.5 — no scraping).
# Both CLIENT_ID and CLIENT_SECRET must be set to enable the provider.
# The URL/scope overrides let you match whichever Instagram Login flow Meta
# assigns your app (Basic Display is being retired).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTH_URL=https://api.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_USERINFO_URL=https://graph.instagram.com/me?fields=id,username
INSTAGRAM_SCOPES=user_profile

# Phone auth — dev logs the OTP to the console; set a real provider for prod.
SMS_PROVIDER_API_KEY=

# Transactional email (password reset + verification) via Resend.
# Unset → dev logs the link to the console (prod throws rather than drop it).
# Set → mail is sent for real. Get the key at resend.com (starts "re_").
EMAIL_PROVIDER_API_KEY=
# Verified sender. Unset → onboarding@resend.dev (delivers only to the Resend
# account owner — fine for a first test). Set to your verified domain address:
# EMAIL_FROM="Mesa <mail@yourdomain.com>"
EMAIL_FROM=

# Google Places typeahead (M8) — the rank flow's "add a restaurant" step offers
# Google autocomplete suggestions for places not yet in Mesa's catalog. SERVER
# ONLY: never expose it to the client, never VITE_-prefix it (Vite inlines every
# VITE_* into the public bundle). Unset → the feature is dark (no suggestions
# ever shown). To enable: Google Cloud console → enable "Places API (New)" →
# create an API key → restrict it to Places API + your server → set it here.
# Billed per autocomplete request; the code requests only place id + name text
# (no Place Details, no coordinates), keeping it on the cheapest SKU.
GOOGLE_PLACES_API_KEY=
