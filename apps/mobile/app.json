{
  "expo": {
    "name": "Mesa",
    "slug": "mesa",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mesa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mesa.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.mesa.app",
      "adaptiveIcon": {
        "backgroundColor": "#f3efe6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3efe6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mesa usa tu ubicación solo cuando tocas “Cerca”, para ordenar los spots por cercanía."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mesa accede a tus fotos solo para adjuntar la foto de un plato que elijas.",
          "cameraPermission": "Mesa usa la cámara solo para tomar la foto de un plato."
        }
      ],
      "@rnmapbox/maps",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
