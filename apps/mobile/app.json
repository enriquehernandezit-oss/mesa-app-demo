{
  "expo": {
    "name": "Mesa",
    "slug": "mesa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mesa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mesasocial.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp"]
      }
    },
    "android": {
      "package": "com.mesasocial.app",
      "adaptiveIcon": {
        "backgroundColor": "#f3efe6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3efe6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mesa usa tu ubicación solo cuando tocas “Cerca”, para ordenar los spots por cercanía."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mesa accede a tus fotos solo para usar la que elijas como foto de perfil o foto de un plato.",
          "cameraPermission": "Mesa usa la cámara solo para tomar tu foto de perfil o la foto de un plato."
        }
      ],
      "@rnmapbox/maps",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Mesa compara los números de tus contactos con miembros de Mesa para encontrar a tus amigos. No guardamos tu lista de contactos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "04278970-156c-4abe-9757-9d8f893df404"
      }
    }
  }
}
