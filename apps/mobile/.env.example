# Expo inlines EXPO_PUBLIC_* into the client bundle (same idea as Vite's VITE_*).
# The Mesa API base — the deployed Hono service (see docs/DEPLOY.md).
EXPO_PUBLIC_API_URL=http://localhost:3000
# MapBox public token (pk.…) — restrict it to this app's bundle id in MapBox.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Cloudinary cloud name for delivery URLs (optional; falls back to API-served images).
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# MapBox SDK *download* token (sk.…) — BUILD-TIME ONLY, read by the @rnmapbox/maps
# config plugin during prebuild so CocoaPods can fetch the native SDK. Not shipped
# in the bundle. Set it in your shell / EAS secrets, never commit it.
RNMAPBOX_DOWNLOAD_TOKEN=
