# Expo inlines EXPO_PUBLIC_* into the client bundle (same idea as Vite's VITE_*).
# The Mesa API base — the deployed Hono service (see docs/DEPLOY.md).
EXPO_PUBLIC_API_URL=http://localhost:3000
# MapBox public token (pk.…) — restrict it to this app's bundle id in MapBox.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Cloudinary cloud name for delivery URLs (optional; falls back to API-served images).
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# MapBox SDK *download* token (sk.…) — BUILD-TIME ONLY, read by the @rnmapbox/maps
# config plugin during prebuild so CocoaPods can fetch the native SDK. Not shipped
# in the bundle. Set it in your shell / EAS secrets, never commit it.
RNMAPBOX_DOWNLOAD_TOKEN=
# Universal-link domain for password-reset / verify-email emails to open the app
# (e.g. mesa.app) — must match APP_ORIGINS on the API and host the AASA file.
# Build-time only; the mesa:// scheme works without it.
APP_LINK_DOMAIN=

# --- Analytics & crash reporting (optional; unset = both are no-ops) ---
# PostHog project API key. Without it, no events are sent and the app behaves
# identically — which is also what you want in local dev, so leave it unset here
# and set it on EAS instead (per-environment: development / preview / production).
EXPO_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com — set only for the EU region.
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry DSN for the app. Unset = no reports.
EXPO_PUBLIC_SENTRY_DSN=

# --- Build-time only (Sentry source maps) ---
# Both required together, or the Sentry Expo plugin isn't registered at all
# (see app.config.js). SENTRY_AUTH_TOKEN is supplied by EAS as a secret.
SENTRY_ORG=
SENTRY_PROJECT=
