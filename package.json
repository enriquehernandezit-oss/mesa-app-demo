{
  "name": "mesa",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && cd apps/mobile && bunx tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "bun run --filter '@mesa/db' generate",
    "db:migrate": "bun run --filter '@mesa/db' migrate",
    "db:seed": "bun run --filter '@mesa/db' seed",
    "api:dev": "bun run --filter '@mesa/api' dev",
    "test": "bun run --filter '*' test && cd apps/mobile && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22"
  }
}
