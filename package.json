{
  "name": "mesa",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "bun run --filter '@mesa/db' generate",
    "db:migrate": "bun run --filter '@mesa/db' migrate",
    "db:seed": "bun run --filter '@mesa/db' seed",
    "api:dev": "bun run --filter '@mesa/api' dev",
    "app:dev": "bun run --filter '@mesa/app' dev",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.3"
  }
}
